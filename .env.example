# ===== Database =====
# Port 5435 dipakai di docker-compose proyek ini (menghindari bentrok Postgres lain)
DATABASE_URL="postgresql://tt:ttpass@localhost:5435/ttdb?schema=public"

# ===== App =====
APP_URL="http://localhost:3015"
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Kosongkan = deteksi otomatis dari header x-forwarded-proto.
# Isi "true" bila aplikasi di belakang HTTPS, "false" untuk memaksa http.
COOKIE_SECURE=""

# ===== Payment gateway =====
# mock = langsung jalan tanpa akun. midtrans = Snap sandbox. xendit = Invoice API.
PAYMENT_PROVIDER="mock"
PAYMENT_CALLBACK_TOKEN="callback-token-demo"
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# Isi dengan key sandbox Xendit (xnd_development_...) bila PAYMENT_PROVIDER=xendit
XENDIT_SECRET_KEY=""

# ===== n8n automation =====
# Untuk run lokal (pnpm dev): URL webhook n8n di host.
# Di Docker Compose nilai ini DIABAIKAN untuk container app — compose memakai
# http://n8n:5678/webhook/kelaskita-order (nama service di network Docker).
# Kosongkan bila belum meng-import workflow.
N8N_WEBHOOK_URL="http://localhost:5678/webhook/kelaskita-order"
# Secret untuk callback balik dari n8n ke app
INTERNAL_SECRET="internal-secret-demo"
