# ===== Database =====
# Port 5435 dipakai di docker-compose proyek ini (menghindari bentrok Postgres lain)
DATABASE_URL="postgresql://tt:ttpass@localhost:5435/ttdb?schema=public"

# ===== App =====
APP_URL="http://localhost:3015"
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# ===== Payment gateway =====
# mock = langsung jalan tanpa akun. midtrans = pakai Snap sandbox (isi server key)
PAYMENT_PROVIDER="mock"
PAYMENT_CALLBACK_TOKEN="callback-token-demo"
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# ===== n8n automation =====
# URL webhook production n8n untuk event order.created (kosongkan = skip)
N8N_WEBHOOK_URL="http://localhost:5678/webhook/kelaskita-order"
# Secret untuk callback balik dari n8n ke app
INTERNAL_SECRET="internal-secret-demo"
